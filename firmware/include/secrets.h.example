// Copy this file to secrets.h (same directory) and fill in real
// values. secrets.h is gitignored at the repo root (see .gitignore:
// "secrets.h" / "**/secrets.h") -- it will never be committed, so it's
// safe to put a real WiFi password and OTA key in it.
//
// Both defines below are OPTIONAL. Omit either one (or the whole
// file) and the firmware falls back to safe defaults:
//   - No GLIDE_WIFI_SSID/PASS: WiFiManager's own captive portal is
//     used instead (see firmware/lib/api/wifi_setup.h) -- the normal
//     path for anyone who isn't Josh bench-testing on a known network.
//   - No GLIDE_OTA_KEY: a hardcoded default key compiles in (see
//     firmware/lib/api/ota_handler.cpp), with a loud warning printed
//     over serial every boot. Fine for a single LAN-only bench device;
//     set a real one here before this thing is ever reachable beyond
//     your own network.

// Bench-testing shortcut: skips WiFiManager's portal and connects
// directly to a known network. Comment out (or delete this file) to
// go back to the normal captive-portal flow.
// #define GLIDE_WIFI_SSID "your-network-name"
// #define GLIDE_WIFI_PASS "your-network-password"

// Shared secret required in the X-Glide-OTA-Key header on
// POST /api/v1/ota -- see docs/api.md's Auth section.
// #define GLIDE_OTA_KEY "pick-something-long-and-random"
