# --- Secrets: never commit these, no matter what else changes below ---
secrets.h
**/secrets.h
.env
**/.env
.env.*
!.env.example

# --- PlatformIO ---
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/
firmware/.vscode/.browse.c_cpp.db*
firmware/.vscode/c_cpp_properties.json
firmware/.vscode/launch.json
firmware/.vscode/ipch/

# --- M4: auto-generated on every build by firmware/scripts/embed_webui.py --
# never hand-edited, never committed (see firmware/lib/api/webui_assets.h
# for the stable, hand-written interface it implements).
firmware/lib/api/webui_assets_data.cpp

# --- Node / Vite (webui) ---
node_modules/
webui/dist/
webui/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / OS cruft ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Build artifacts ---
*.o
*.bin
*.elf
*.map

# --- Python (firmware/scripts/embed_webui.py, run by PlatformIO) ---
__pycache__/
*.pyc
